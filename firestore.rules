rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if user has admin or manager role
    function isStaff() {
      return request.auth != null && (
        request.auth.token.role == 'admin' || 
        request.auth.token.role == 'manager'
      );
    }

    // Helper to check if user is student or teacher of the notebook, or is staff
    function canAccessNotebook(notebookId) {
      let notebook = get(/databases/$(database)/documents/Notebooks/$(notebookId)).data;
      return request.auth != null && (
        isStaff() ||
        notebook.studentId == request.auth.uid || 
        notebook.teacherId == request.auth.uid
      );
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }

    match /Notebooks/{notebookId} {
      // The notebook document is written only by the server (Admin SDK)
      allow read: if request.auth != null && (
        isStaff() ||
        resource.data.studentId == request.auth.uid ||
        resource.data.teacherId == request.auth.uid
      );
      allow write: if false;

      // Subcollections (legacy yjs/history): readable by participants, written only by the server
      match /{allPaths=**} {
        allow read: if canAccessNotebook(notebookId);
        allow write: if false;
      }
    }
  }
}
